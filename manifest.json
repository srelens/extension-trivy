    {
      "name": "image-job",
      "title": "Scan image vulnerabilities",
      "target": "k8s.runJob",
      "inputs": [],
      "arguments": {
        "image": "aquasec/trivy@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa",
        "command": [
          "/bin/sh",
          "-c"
        ],
        "args": [
          "case $(uname -m) in aarch64|arm64) platform=linux/arm64;; x86_64) platform=linux/amd64;; *) echo unsupported-worker-architecture >&2; exit 1;; esac; exec trivy image --format json --scanners vuln --platform \"$platform\" --timeout 15m --parallel 1 --no-progress --quiet -- \"$1\"",
          "trivy-scan",
          "${inputs.image}"
        ],
        "inputNames": [
          "image"
        ],
        "readRules": []
      }
    }
